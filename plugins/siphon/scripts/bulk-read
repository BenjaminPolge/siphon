#!/bin/bash
# Delegate file reading to the Gemini bulk-reader mode
# Usage: bulk-read --question "what does this do?" --paths file1.ts file2.ts

# Resolve $0 through symlinks before locating the library: setup offers to link
# these scripts into ~/.local/bin, and dirname on the link would point at the
# link's directory instead of the plugin. macOS has no `readlink -f`.
_src="$0"
while [ -L "$_src" ]; do
  _dir=$(cd -P "$(dirname "$_src")" && pwd)
  _src=$(readlink "$_src")
  case "$_src" in /*) ;; *) _src="$_dir/$_src" ;; esac
done
. "$(cd -P "$(dirname "$_src")" && pwd)/lib/gemini.sh"

MODE_NAME="bulk-reader"

question=""
paths=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --question) question="$2"; shift 2 ;;
    --paths)    shift; while [[ $# -gt 0 && ! "$1" =~ ^-- ]]; do paths+=("$1"); shift; done ;;
    *)          shift ;;
  esac
done

if [ -z "$question" ]; then
  echo "Error: --question is required" >&2
  exit 1
fi

if [ ${#paths[@]} -eq 0 ]; then
  echo "Error: --paths is required" >&2
  exit 1
fi

# A typo'd path would be sent as an empty <file> block and produce a
# confident answer about nothing — fail loudly instead.
for path in "${paths[@]}"; do
  if [ ! -f "$path" ] || [ ! -r "$path" ]; then
    echo "Error: file not found or unreadable: $path" >&2
    exit 1
  fi
done

siphon_preflight || exit 1
siphon_tmpfile message_file || exit 1

# Wrap each file in XML tags so the model sees clear boundaries. Stream
# straight into the message file: no corpus-sized shell variable, and file
# contents survive byte-for-byte.
for path in "${paths[@]}"; do
  {
    printf '<file path="%s">\n' "$path"
    cat "$path"
    printf '</file>\n\n'
  } >> "$message_file"
done
printf 'Question: %s\n' "$question" >> "$message_file"

siphon_invoke "$MODE_NAME" "$message_file" || exit 1

